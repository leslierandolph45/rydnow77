// ─── 3. CHAT ───
export type Msg = { id: string; from: 'rider' | 'customer' | 'system'; text: string; at: number; read?: boolean };
export type CustomerInfo = { name: string; photo?: string; address: string; phone: string; rating: number; trips: number };
export const PRESETS = ['On my way 🛵', 'I’ve arrived', 'Please come outside', 'Running 5 min late', 'Delivery completed'];
export const ChatPanel = ({ k, customer, msgs, onSend, arrived }: { k: K; customer: CustomerInfo; msgs: Msg[]; onSend: (text: string) => void; arrived?: boolean }) => {
  const [text, setText] = useState(''); const end = useRef<HTMLDivElement>(null);
  useEffect(() => { end.current?.scrollIntoView({ behavior: 'smooth' }); }, [msgs.length]);
  const last = msgs[msgs.length - 1];
  const typing = last?.from === 'rider'; // BACKEND: replace with websocket "typing" event from the customer
  const send = (t: string) => { const v = t.trim(); if (v) { onSend(v); setText(''); } };
  return (
    <div className="space-y-3">
      <div className={`flex items-center gap-3 rounded-2xl p-3 ${k.soft}`}>
        {customer.photo ? <img src={customer.photo} alt="" className="h-12 w-12 rounded-full object-cover" /> : <span className="flex h-12 w-12 items-center justify-center rounded-full bg-[#F9D342] text-lg font-black text-[#0A2342]">{customer.name[0]}</span>}
        <div className="min-w-0 flex-1"><p className="truncate text-sm font-extrabold">{customer.name} <span className="inline-flex items-center gap-0.5 text-xs text-emerald-500"><Icon name="check" className="h-3 w-3" />Verified</span></p>
          <p className={`flex items-center gap-1 truncate text-xs ${k.sub}`}><Icon name="pin" className="h-3.5 w-3.5 shrink-0" />{customer.address}</p><p className={`flex items-center gap-1 text-xs ${k.sub}`}><Icon name="star" className="h-3.5 w-3.5 text-[#F9D342]" />{customer.rating} · {customer.trips} completed</p></div>
        <a href={`tel:${customer.phone}`} aria-label={`Call ${customer.name}`} className="flex h-11 w-11 items-center justify-center rounded-full bg-emerald-500 text-white"><Icon name="phone" className="h-5 w-5" /></a>
      </div>
      <p className={`text-[11px] ${k.faint}`}>Phone: {customer.phone}</p>
      {arrived && <p className="flex items-center gap-2 rounded-2xl bg-emerald-100 p-3 text-sm font-bold text-emerald-800"><Icon name="check" className="h-4 w-4 shrink-0" />You have arrived! Message the customer below to notify them</p>}
      <div className="max-h-[38dvh] space-y-2 overflow-y-auto" aria-live="polite">
        {msgs.map(m => m.from === 'system' ? <p key={m.id} className={`text-center text-[11px] ${k.faint}`}>{m.text}</p> : (
          <div key={m.id} className={`flex ${m.from === 'rider' ? 'justify-end' : ''}`}>
            <p className={`max-w-[80%] rounded-2xl px-3 py-2 text-sm ${m.from === 'rider' ? 'bg-[#F9D342] text-[#0A2342]' : k.soft}`}>{m.text}
              {m.from === 'rider' && <span className="ml-2 text-[10px] opacity-70">{m.read ? '✓✓' : '✓'}</span>}</p>
          </div>
        ))}
        {typing && <p className={`text-xs italic ${k.faint}`}>{customer.name.split(' ')[0]} is typing…</p>}
        <div ref={end} />
      </div>
      <div className="-mx-1 flex gap-2 overflow-x-auto px-1">{PRESETS.map(p => <button key={p} onClick={() => send(p)} className={`${TAP} shrink-0 rounded-full border px-3 text-xs font-bold ${k.line}`}>{p}</button>)}</div>
      <div className="flex gap-2"><input value={text} onChange={e => setText(e.target.value)} onKeyDown={e => e.key === 'Enter' && send(text)} placeholder="Type a message…" aria-label="Message" className={inp(k)} /><button onClick={() => send(text)} className={btn(k)} aria-label="Send">Send</button></div>
    </div>
  );
};

// ─── shared: photo picker with preview ───
const usePhoto = () => {
  const [file, setFile] = useState<File | null>(null); const [url, setUrl] = useState<string | null>(null);
  useEffect(() => () => { if (url) URL.revokeObjectURL(url); }, [url]);
  const pick = (f?: File | null) => { if (!f) return; if (!f.type.startsWith('image/')) return false; if (url) URL.revokeObjectURL(url); setFile(f); setUrl(URL.createObjectURL(f)); return true; };
  return { file, url, pick, clear: () => { setFile(null); setUrl(null); } };
};

