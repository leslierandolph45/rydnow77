'use client';
/**
 * RYDNOW — new rider features (modular). Save as: components/rider-features.tsx
 * Drop-in for app/rider-dashboard/page.tsx. Nothing in the existing page is removed.
 * Every component takes the page's theme tokens (`k`) so the design system is unchanged.
 * Wrap the *Panel components in the page's existing <Sheet>. Search "BACKEND:" for API hooks.
 */
import { useEffect, useRef, useState } from 'react';
import { Icon, type IconName } from './icons';

type K = Record<string, string>;
type Notify = (m: string, t?: 'ok' | 'err' | 'info') => void;
const money = (n: number) => n.toFixed(2);
const PRESS = 'transition active:scale-[0.97] hover:brightness-95';
const TAP = 'min-h-[44px]';
const MIN_DEPOSIT = 50;
const WITHDRAW_RATE = 0.85;
const btn = (k: K) => `${TAP} rounded-full ${k.btn} px-4 text-sm font-extrabold ${PRESS}`;
const gold = `${TAP} rounded-full bg-[#F9D342] px-4 text-sm font-extrabold text-[#0A2342] ${PRESS}`;
const ghost = (k: K) => `${TAP} rounded-full border ${k.line} px-4 text-sm font-bold ${k.ink} ${PRESS}`;
const L = (name: IconName, text: string) => <span className="inline-flex items-center justify-center gap-2"><Icon name={name} className="h-4 w-4 shrink-0" />{text}</span>;
const inp = (k: K) => `${TAP} w-full rounded-xl border px-3 text-base outline-none focus:ring-2 focus:ring-[#F9D342] ${k.input}`;

// ─── 1. WALLET ───
export type Dest = { type: 'momo' | 'card'; masked: string } | null; // locked after first deposit
export const WalletPanel = ({ k, balance, totalEarnings, dest, onDeposit, onWithdraw, notify, view }: {
  k: K; view?: 'deposit' | 'withdraw'; balance: number; totalEarnings: number; dest: Dest; notify: Notify;
  onDeposit: (amount: number, d: NonNullable<Dest>) => void; onWithdraw: (amount: number) => void;
}) => {
  const [method, setMethod] = useState<'momo' | 'card'>(dest?.type ?? 'momo');
  const [phone, setPhone] = useState(''); const [amount, setAmount] = useState('');
  const [card, setCard] = useState({ num: '', exp: '', cvv: '' });
  const [confirm, setConfirm] = useState(false); const [busy, setBusy] = useState(false);
  const withdrawable = +(balance * WITHDRAW_RATE).toFixed(2);
  const held = +(balance - withdrawable).toFixed(2);
  const locked = !!dest; // destination can never change
  const show = (v: string) => !view || view === v;

  const deposit = async () => {
    const a = Number(amount);
    if (!(a >= MIN_DEPOSIT)) return notify(`Minimum deposit is ${MIN_DEPOSIT} GHS.`, 'err');
    let d: NonNullable<Dest>;
    if (method === 'momo') {
      if (!/^0\d{9}$/.test(phone)) return notify('Enter a valid 10-digit Mobile Money number.', 'err');
      if (locked && dest!.masked !== `•••• ${phone.slice(-4)}`) return notify('Deposits must come from your saved payment method.', 'err');
      d = { type: 'momo', masked: `•••• ${phone.slice(-4)}` };
    } else {
      const n = card.num.replace(/\s/g, '');
      if (!/^\d{13,19}$/.test(n) || !/^\d{2}\/\d{2}$/.test(card.exp) || !/^\d{3,4}$/.test(card.cvv)) return notify('Check your card details.', 'err');
      if (locked && dest!.masked !== `•••• ${n.slice(-4)}`) return notify('Deposits must come from your saved payment method.', 'err');
      d = { type: 'card', masked: `•••• ${n.slice(-4)}` };
    }
    setBusy(true);
    // BACKEND: momo → POST /wallet/deposit/momo/ (customer approves prompt on phone). card → use your gateway's hosted
    // fields (Paystack/Flutterwave). Never send raw card numbers to your own server; this demo only keeps the last 4.
    await new Promise(r => setTimeout(r, 900));
    setBusy(false); onDeposit(a, d); setAmount(''); setCard({ num: '', exp: '', cvv: '' });
    notify('Check your phone and approve the payment prompt. Deposit received.', 'ok');
  };
  const withdraw = async () => {
    setBusy(true); setConfirm(false);
    await new Promise(r => setTimeout(r, 800)); // BACKEND: POST /wallet/withdraw/ { amount } — server recomputes 85% and uses the stored destination
    setBusy(false); onWithdraw(withdrawable); notify(`GH₵ ${money(withdrawable)} sent to ${dest!.masked}.`, 'ok');
  };

  return (
    <div className="space-y-3">
      <div className="grid grid-cols-3 gap-2 text-center">
        {[['Available', withdrawable], ['Held (15%)', held], ['Total earnings', totalEarnings]].map(([l, v]) => (
          <div key={l as string} className={`rounded-2xl p-3 ${k.soft}`}><p className={`text-[11px] ${k.sub}`}>{l as string}</p><p className={`text-base font-black ${k.ink}`}>GH₵ {money(v as number)}</p></div>
        ))}
      </div>
      {show('withdraw') && (<>
      <button onClick={() => (dest ? setConfirm(true) : notify('Make a deposit first. Withdrawals go back to the number or card you deposit with.', 'info'))}
        disabled={busy || withdrawable <= 0} className={`flex w-full items-center justify-center gap-2 disabled:opacity-50 ${gold} !min-h-[52px]`}>{L('withdraw', `Withdraw Funds · GH₵ ${money(withdrawable)}`)}</button>
      <p className={`text-xs ${k.sub}`}>Instantly withdraw 85% of your balance. 15% stays held for platform fees. {dest ? `Funds go only to ${dest.masked}.` : ''}</p>
      {confirm && dest && (
        <div className="rounded-2xl border-2 border-[#F9D342] p-3" role="alertdialog">
          <p className={`text-sm font-bold ${k.ink}`}>Funds will be sent to {dest.masked}. Confirm withdrawal?</p>
          <div className="mt-3 flex gap-3"><button onClick={() => setConfirm(false)} className={`flex-1 ${ghost(k)}`}>Cancel</button><button onClick={withdraw} className={`flex-[2] ${btn(k)}`}>Confirm</button></div>
        </div>
      )}
      </>)}
      {show('deposit') && (<>
      <p className="flex items-start gap-2 rounded-2xl bg-amber-100 p-3 text-sm font-bold text-amber-900"><Icon name="alert" className="mt-0.5 h-4 w-4 shrink-0" /><span>Minimum deposit: {MIN_DEPOSIT} GHS (Cedis) is required to receive delivery jobs.</span></p>
      <div className={`grid grid-cols-2 rounded-full p-1 ${k.soft}`}>
        {([['momo', 'Mobile Money'], ['card', 'Card']] as const).map(([v, l]) => (
          <button key={v} onClick={() => !locked && setMethod(v)} disabled={locked && dest!.type !== v} className={`${TAP} rounded-full text-xs font-bold disabled:opacity-40 ${method === v ? `${k.btn} shadow` : k.sub}`}>{L(v === 'momo' ? 'mobile' : 'card', l)}</button>
        ))}
      </div>
      {method === 'momo' ? (
        <label className="block"><span className={`mb-1 block text-xs font-semibold ${k.faint}`}>Mobile Money number</span><input type="tel" inputMode="numeric" value={phone} onChange={e => setPhone(e.target.value.replace(/\D/g, '').slice(0, 10))} placeholder="0541234567" className={inp(k)} /></label>
      ) : (
        <div className="space-y-2">
          <input aria-label="Card number" inputMode="numeric" autoComplete="cc-number" placeholder="Card number" value={card.num} onChange={e => setCard(c => ({ ...c, num: e.target.value.replace(/[^\d ]/g, '').slice(0, 23) }))} className={inp(k)} />
          <div className="flex gap-2"><input aria-label="Expiry" autoComplete="cc-exp" placeholder="MM/YY" value={card.exp} onChange={e => setCard(c => ({ ...c, exp: e.target.value.slice(0, 5) }))} className={inp(k)} /><input aria-label="CVV" type="password" inputMode="numeric" autoComplete="cc-csc" placeholder="CVV" value={card.cvv} onChange={e => setCard(c => ({ ...c, cvv: e.target.value.replace(/\D/g, '').slice(0, 4) }))} className={inp(k)} /></div>
        </div>
      )}
      <label className="block"><span className={`mb-1 block text-xs font-semibold ${k.faint}`}>Amount (GH₵)</span><input type="number" inputMode="decimal" value={amount} onChange={e => setAmount(e.target.value)} placeholder={String(MIN_DEPOSIT)} className={inp(k)} /></label>
      <button onClick={deposit} disabled={busy} className={`flex w-full items-center justify-center gap-2 disabled:opacity-60 ${btn(k)}`}>{busy ? 'Processing…' : method === 'momo' ? 'Send payment prompt' : 'Pay securely'}</button>
      </>)}
    </div>
  );
};

