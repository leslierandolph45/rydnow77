    <div className="space-y-3">
      <p className="flex items-start gap-2 rounded-2xl bg-sky-100 p-3 text-sm font-semibold text-sky-900"><Icon name="camera" className="mt-0.5 h-4 w-4 shrink-0" /><span>Clear face photo required — this helps customers identify and verify you. Must be a clear headshot with good lighting.</span></p>
      <div className="flex items-center gap-3">
        {(p.url || current) ? <img src={p.url || current} alt="Your profile photo" className="h-20 w-20 rounded-full object-cover" /> : <span className={`flex h-20 w-20 items-center justify-center rounded-full ${k.soft}`}><Icon name="user" className="h-9 w-9" /></span>}
        <span className={`rounded-full px-3 py-1 text-xs font-bold ${status === 'verified' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-800'}`}>{status === 'verified' ? 'Verified' : status === 'pending' ? 'Pending Verification' : 'No photo yet'}</span>
      </div>
      {!p.file ? (
        <div className="grid grid-cols-2 gap-3">
          <label className={`flex cursor-pointer items-center justify-center ${gold}`}>{L('camera', 'Camera')}<input type="file" accept="image/*" capture="user" className="sr-only" onChange={e => p.pick(e.target.files?.[0]) === false && notify('Please choose an image.', 'err')} /></label>
          <label className={`flex cursor-pointer items-center justify-center ${ghost(k)}`}>{L('file', 'Gallery')}<input type="file" accept="image/*" className="sr-only" onChange={e => p.pick(e.target.files?.[0]) === false && notify('Please choose an image.', 'err')} /></label>
        </div>
      ) : (
        <div className="flex gap-3"><button onClick={p.clear} disabled={busy} className={`flex-1 ${ghost(k)}`}>Retake</button>
          <button disabled={busy} onClick={async () => { setBusy(true); try { await onSave(p.file!, p.url!); p.clear(); notify('Photo submitted for verification.', 'ok'); } catch { notify('We couldn’t upload your photo. Please try again.', 'err'); } finally { setBusy(false); } }} className={`flex-[2] disabled:opacity-60 ${btn(k)}`}>{busy ? 'Uploading…' : 'Confirm & save'}</button></div>
      )}
      <p className={`text-xs ${k.faint}`}>Customers see your photo in job details, chat and active delivery status.</p>
    </div>
  );
};

// ─── 5. PROOF OF DELIVERY ───
export const ProofPanel = ({ k, onSubmit, notify }: { k: K; onSubmit: (proof: { file?: File; code?: string }) => Promise<void>; notify: Notify }) => {
  const p = usePhoto(); const [mode, setMode] = useState<'photo' | 'scan'>('photo'); const [code, setCode] = useState(''); const [busy, setBusy] = useState(false);
  const videoRef = useRef<HTMLVideoElement>(null); const [scanning, setScanning] = useState(false);
  const canScan = typeof window !== 'undefined' && 'BarcodeDetector' in window;

  useEffect(() => {
    if (!scanning) return;
    let stop = false; let stream: MediaStream | null = null;
    (async () => {
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        if (videoRef.current) { videoRef.current.srcObject = stream; await videoRef.current.play(); }
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const det = new (window as any).BarcodeDetector({ formats: ['qr_code', 'code_128', 'ean_13', 'code_39'] });
        while (!stop) {
          const r = videoRef.current ? await det.detect(videoRef.current).catch(() => []) : [];
          if (r.length) { setCode(r[0].rawValue); setScanning(false); break; }
          await new Promise(res => setTimeout(res, 300));
        }
      } catch { notify('Camera unavailable. Type the code instead.', 'err'); setScanning(false); }
    })();
    return () => { stop = true; stream?.getTracks().forEach(t => t.stop()); };
  }, [scanning, notify]);

  const ready = mode === 'photo' ? !!p.file : code.trim().length >= 3;
  const submit = async () => {
    setBusy(true);
    try { await onSubmit(mode === 'photo' ? { file: p.file! } : { code: code.trim() }); } // BACKEND: POST /complete-ride/ multipart {proof_image | proof_code}; store privately, link to job
    catch { notify('We couldn’t submit your proof. Please try again.', 'err'); } finally { setBusy(false); }
  };
  return (
    <div className="space-y-3">
      <p className="flex items-start gap-2 rounded-2xl bg-amber-100 p-3 text-sm font-bold text-amber-900"><Icon name="camera" className="mt-0.5 h-4 w-4 shrink-0" /><span>Confirm Delivery — Take Photo or Scan to Submit Proof</span></p>
      <div className={`grid grid-cols-2 rounded-full p-1 ${k.soft}`}>{([['photo', 'Take Photo', 'camera'], ['scan', 'Scan QR / Barcode', 'receipt']] as const).map(([v, l, ic]) => <button key={v} onClick={() => setMode(v)} className={`${TAP} rounded-full text-xs font-bold ${mode === v ? `${k.btn} shadow` : k.sub}`}>{L(ic, l)}</button>)}</div>
      {mode === 'photo' ? (p.url ? (
        <div className="space-y-2"><img src={p.url} alt="Delivery proof preview" className="max-h-64 w-full rounded-2xl object-cover" /><button onClick={p.clear} className={`w-full ${ghost(k)}`}>Retake</button></div>
      ) : <label className={`flex cursor-pointer items-center justify-center ${gold}`}>{L('camera', 'Open camera')}<input type="file" accept="image/*" capture="environment" className="sr-only" onChange={e => p.pick(e.target.files?.[0]) === false && notify('Please choose an image.', 'err')} /></label>
      ) : (
        <div className="space-y-2">
          {scanning && <video ref={videoRef} muted playsInline className="h-56 w-full rounded-2xl bg-black object-cover" />}
          {canScan && <button onClick={() => setScanning(s => !s)} className={`w-full ${gold}`}>{scanning ? 'Stop scanning' : L('camera', 'Scan code')}</button>}
          <input value={code} onChange={e => setCode(e.target.value)} placeholder={canScan ? 'Scanned or typed code' : 'Scanning isn’t supported here. Type the code'} aria-label="Delivery code" className={inp(k)} />
        </div>
      )}
      <button onClick={submit} disabled={!ready || busy} className={`w-full disabled:opacity-50 ${btn(k)}`}>{busy ? 'Submitting…' : 'Submit Proof & Complete Delivery'}</button>
    </div>
  );
};

